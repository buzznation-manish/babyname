# Supabase transaction pooler connection string. `pgbouncer=true` disables Prisma prepared statements, which conflict with Supabase's transaction pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct database connection string for Prisma migrations/introspection.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
